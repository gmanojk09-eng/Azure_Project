{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-retail-data-01"
		},
		"ls_retail_crm_cosmos_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_retail_crm_cosmos'"
		},
		"ls_retail_pos_sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_retail_pos_sql'"
		},
		"ls_retail_storage_mi_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_retail_storage_mi'"
		},
		"ls_retail_storage_sql_private_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_retail_storage_sql_private'"
		},
		"ls_retail_supplier_sftp_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_retail_supplier_sftp'"
		},
		"ls_retail_pos_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "manoj1202.database.windows.net"
		},
		"ls_retail_pos_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "Manoj"
		},
		"ls_retail_pos_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "manoj1202"
		},
		"ls_retail_storage_mi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dataretail19112026.dfs.core.windows.net/"
		},
		"ls_retail_storage_sql_private_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dataretail19112026.dfs.core.windows.net/"
		},
		"ls_retail_supplier_sftp_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "dataretail19112026.blob.core.windows.net"
		},
		"ls_retail_supplier_sftp_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "dataretail19112026.sshretaildemo"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-retail-data-01_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_retail_crm_cosmos_connectionString": {
						"value": "[parameters('ls_retail_crm_cosmos_connectionString')]"
					},
					"ls_retail_pos_sql_password": {
						"value": "[parameters('ls_retail_pos_sql_password')]"
					},
					"ls_retail_storage_mi_accountKey": {
						"value": "[parameters('ls_retail_storage_mi_accountKey')]"
					},
					"ls_retail_storage_sql_private_accountKey": {
						"value": "[parameters('ls_retail_storage_sql_private_accountKey')]"
					},
					"ls_retail_supplier_sftp_password": {
						"value": "[parameters('ls_retail_supplier_sftp_password')]"
					},
					"ls_retail_pos_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_retail_pos_sql_properties_typeProperties_server')]"
					},
					"ls_retail_pos_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_retail_pos_sql_properties_typeProperties_database')]"
					},
					"ls_retail_pos_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_retail_pos_sql_properties_typeProperties_userName')]"
					},
					"ls_retail_storage_mi_properties_typeProperties_url": {
						"value": "[parameters('ls_retail_storage_mi_properties_typeProperties_url')]"
					},
					"ls_retail_storage_sql_private_properties_typeProperties_url": {
						"value": "[parameters('ls_retail_storage_sql_private_properties_typeProperties_url')]"
					},
					"ls_retail_supplier_sftp_properties_typeProperties_host": {
						"value": "[parameters('ls_retail_supplier_sftp_properties_typeProperties_host')]"
					},
					"ls_retail_supplier_sftp_properties_typeProperties_userName": {
						"value": "[parameters('ls_retail_supplier_sftp_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}